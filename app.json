{
  "expo": {
    "name": "VCALL",
    "slug": "vcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "vcall",
    "android": {
      "package": "com.vcall.app",
      "adaptiveIcon": {
        "backgroundColor": "#111A3A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0"
          }
        }
      ],
      "./plugins/withFirebaseBomOverride"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
