{
  "expo": {
    "name": "VCALL",
    "slug": "vcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "vcall",
    "android": {
      "package": "com.vcall.app",
      "adaptiveIcon": {
        "backgroundColor": "#111A3A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "READ_CONTACTS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0"
          }
        }
      ],
      "./plugins/withFirebaseBomOverride",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow VCALL to access your contacts so you can find people to connect with."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "bundleIdentifier": "com.vcall.app"
    },
    "extra": {
      "eas": {
        "projectId": "274235fb-4df7-4bfc-a43f-85a9e963c7df"
      }
    }
  }
}
